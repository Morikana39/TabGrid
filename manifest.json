{
  "manifest_version": 3,
  "name": "TabGrid",
  "version": "1.2.0",
  "description": "__MSG_description__",
  "permissions": [
    "tabs",
    "activeTab",
    "tabGroups",
    "storage",
    "scripting",
    "favicon",
    "unlimitedStorage",
    "sessions",
    "alarms"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob:; connect-src 'none';"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "assets/icons/extension/icon-16.png",
      "32": "assets/icons/extension/icon-32.png"
    }
  },
  "minimum_chrome_version": "120",
  "incognito": "split",
  "optional_permissions": [
    "bookmarks",
    "readingList"
  ],
  "icons": {
    "16": "assets/icons/extension/icon-16.png",
    "32": "assets/icons/extension/icon-32.png",
    "48": "assets/icons/extension/icon-48.png",
    "128": "assets/icons/extension/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "description": "__MSG_openTabGrid__"
    }
  },
  "default_locale": "en"
}
